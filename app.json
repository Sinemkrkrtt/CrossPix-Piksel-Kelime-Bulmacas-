{
  "expo": {
    "name": "CrossPix",
    "slug": "crosspix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.devast.developerteam.crosspix",
      "buildNumber": "10",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.devast.developerteam.crosspix",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "4a786663-9a70-4c73-a644-cbed43bdf6f7"
      }
    }
  }
}
